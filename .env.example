# Copie para .env.local e preencha (ou rode: vercel env pull .env.local)
# Sem as variáveis do Supabase o site abre normalmente, só o blog fica vazio.

# Supabase (blog + admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=

# Busca com IA no blog (opcional)
OPENAI_API_KEY=

# Formulário de contato via Resend (opcional)
RESEND_API_KEY=
CONTACT_FORM_FROM=
